// Copy to Secrets.xcconfig and fill in. NEVER commit Secrets.xcconfig.
// Host only — no scheme. "//" starts a comment in xcconfig files, so a full
// https:// URL would be silently truncated.
COACH_API_HOST = fitness-coach-api.your-subdomain.workers.dev
COACH_SHARED_SECRET = paste-the-value-from-worker/.app-secret

// Coach Gateway for the MiniMax realtime voice path. Host[:port] only.
// Simulator: 127.0.0.1:8787.
// Physical phone: use a stable deployed TLS host, or a Mac LAN IP only when
// phone and Mac are peers on the same router. An iPhone acting as the Mac's
// hotspot cannot reliably call back into the Mac hotspot client.
REALTIME_GATEWAY_HOST = 127.0.0.1:8787

// This protects the public MiniMax Gateway. It is intentionally separate from
// COACH_SHARED_SECRET and must be copied from VANCE_GATEWAY_SECRET in the
// private production configuration.
REALTIME_GATEWAY_SECRET = paste-the-value-from-backend/.env
