# Never commit real values. Configure these through the deployment platform's Secret Manager.
MINIMAX_API_KEY=sk-api-your-minimax-key
KIMI_API_KEY=sk-your-kimi-key

# Optional during local development. When set, every HTTP and WebSocket request
# must carry Authorization: Bearer <value>.
VANCE_GATEWAY_SHARED_SECRET=local-development-secret

PORT=8899
BIND_HOST=127.0.0.1
