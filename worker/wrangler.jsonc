{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-coach-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  // Required by @anthropic-ai/sdk (it imports node: built-ins).
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-coach",
      "database_id": "834a2b60-8b35-450d-93ba-58c8a2634434"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets are NOT listed here. They live in Cloudflare, set with
  // `wrangler secret put`. Anything written in this file is public.
}
